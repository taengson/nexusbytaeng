/* nexus.tcss - Professional Dark Theme for NexusByTaeng */

.hidden {
    display: none;
}

Screen {
    background: #111216;
    color: #e3e6ed;
    layout: horizontal;
}

#sidebar {
    width: 20;
    height: 100%;
    background: #1a1d26;
    border-right: solid #2a2d3d;
    padding: 1;
}

#sidebar-label {
    text-style: bold;
    color: $primary;
}

#main-area {
    width: 1fr;
    height: 100%;
}

#workspace-container {
    width: 100%;
    height: 100%;
    layout: horizontal;
}

#global-project-panel {
    width: 30;
    height: 100%;
    background: #14161d;
    border-right: solid #2a2d3d;
}

#workspaces {
    width: 1fr;
    height: 100%;
    min-height: 100%;
}

#chat-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
    background: #111216;
}

/* Message List Area */
#message-list {
    height: 1fr;
    overflow-y: scroll;
    padding: 1 2;
}

/* Card-style Message Bubbles -> Minimal Text Layout */
.msg-container {
    width: 100%;
    height: auto;
    margin: 1 0;
    layout: horizontal;
}

.msg-container.user-msg {
    align-horizontal: left;
}

.msg-container.ai-msg {
    align-horizontal: left;
}

.msg-container.sys-msg {
    align-horizontal: center;
}

.user-text {
    color: #f8fafc;
    text-style: bold;
    width: 100%;
    text-align: left;
}

.ai-text {
    color: #e2e8f0;
    width: 100%;
    text-align: left;
}

.sys-text {
    text-align: center;
    color: #fef08a;
    text-style: italic;
    width: 100%;
}

.shell-text {
    text-align: left;
    color: #e3e6ed;
    width: 100%;
    padding-left: 2;
}




/* --- MODAL & SUGGESTION STYLE --- */
#confirm-modal-container {
    background: #1a1d26;
    border: tall $primary;
    padding: 2 4;
    width: 50;
    height: auto;
    min-height: 8;
    align: center middle;
}

#confirm-modal-title {
    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: 1;
}

#confirm-modal-text {
    text-align: center;
    margin-bottom: 2;
}

#confirm-modal-buttons {
    layout: horizontal;
    align: center middle;
    height: auto;
}

#confirm-modal-buttons Button {
    color: #ffffff !important;
    border: tall #ffffff;
    margin: 0 1;
}

/* --- INPUT ENGINE MODES --- */
#input-container.input-engine-mode-normal {
    border-top: tall #2a2d3d;
}

#input-container.input-engine-mode-shell {
    border-top: tall #ef4444 !important; /* Red for danger/shell */
    background: #2d1a1a !important;
}
HomeScreen {
    align: center middle;
    background: #0d0e11;
}

#home-container {
    width: 60;
    height: auto;
    padding: 2 4;
    border: double $primary;
    background: #16181f;
    align: center middle;
}

#home-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#home-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
}

.menu-button {
    width: 100%;
    margin: 1 0;
    height: 3;
    content-align: center middle;
}

/* Mode-specific Button styles in Home */
#btn-local {
    background: #1d3557;
    border: tall #457b9d;
    color: #f1faee;
}
#btn-local:hover {
    background: #457b9d;
}

#btn-network {
    background: #134e5e;
    border: tall #2f80ed;
    color: #f1faee;
}
#btn-network:hover {
    background: #2f80ed;
}

#btn-gemini {
    background: #4a154b;
    border: tall #8a2be2;
    color: #ffffff;
}
#btn-gemini:hover {
    background: #8a2be2;
}

#btn-opencode {
    background: #e65c00;
    border: tall #f9d423;
    color: #ffffff;
}
#btn-opencode:hover {
    background: #f9d423;
}


/* --- INPUT AREA & QUICK SETTINGS STYLE --- */
#input-container {
    height: auto;
    min-height: 3;
    background: #16181f;
    border-top: tall #2a2d3d;
    padding: 0 2;
    layout: vertical;
}

#input-row {
    layout: horizontal;
    height: 3;
}

#input-field {
    width: 1fr;
    background: #1e2030;
    color: #e3e6ed;
    border: tall #313244;
}

#input-field:focus {
    border: tall $primary;
}

#settings-btn {
    width: 6;
    height: 3;
    margin-left: 1;
    background: #313244;
    border: tall #45475a;
    content-align: center middle;
}

#settings-btn:hover {
    background: #45475a;
}

#status-bar {
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-style: italic;
}

#input-guide {
    height: 1;
    color: #64748b;
    text-style: italic;
}

/* Mode-specific Input borders */
.input-mode-local {
    border-top: tall #3b82f6 !important;
}
.input-mode-network {
    border-top: tall #10b981 !important;
}
.input-mode-gemini {
    border-top: tall #8b5cf6 !important;
}
.input-mode-opencode {
    border-top: tall #f97316 !important;
}

/* --- QUICK SETTINGS OVERLAY --- */
#quick-settings-panel {
    display: none;
}

#quick-settings-panel.visible {
    display: block;
}

#qs-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    border-bottom: solid #313244;
    padding-bottom: 1;
}

.qs-option-btn {
    width: 100%;
    margin: 1 0;
    height: 3;
}

/* --- SESSION WORKSPACE STYLE --- */
SessionWorkspace {
    layout: horizontal;
    height: 1fr;
}
#project-panel {
    width: 30;
    height: 100%;
    background: #14161d;
    border-right: solid #2a2d3d;
}

#project-header {
    height: 3;
    padding: 1 2;
    background: #1a1d26;
    color: $text;
    text-style: bold;
    border-bottom: solid #2a2d3d;
}

#project-tree {
    height: 1fr;
    background: transparent;
    border: none;
}

#chat-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
    background: #111216;
}

/* Message List Area */
#message-list {
    height: 1fr;
    overflow-y: scroll;
    padding: 1 2;
}

/* Card-style Message Bubbles -> Minimal Text Layout */
.msg-container {
    width: 100%;
    height: auto;
    margin: 1 0;
    layout: horizontal;
}

.msg-container.user-msg {
    align-horizontal: left;
}

.msg-container.ai-msg {
    align-horizontal: left;
}

.msg-container.sys-msg {
    align-horizontal: center;
}

.user-text {
    color: #f8fafc;
    text-style: bold;
    width: 100%;
    text-align: left;
}

.ai-text {
    color: #e2e8f0;
    width: 100%;
    text-align: left;
}

.sys-text {
    text-align: center;
    color: #fef08a;
    text-style: italic;
    width: 100%;
}

.shell-text {
    text-align: left;
    color: #e3e6ed;
    width: 100%;
    padding-left: 2;
}


